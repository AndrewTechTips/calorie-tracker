# Supabase — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-public-key

# Google AI Studio — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Smart model routing: ordered candidate list. Each entry is a bare model
# name (uses GEMINI_MODEL_RPM/RPD below) or "name:rpm:rpd" for its own limit
# — free-tier quotas vary a lot by model (check `api_limits`, repo root, and
# Google AI Studio for this project's real numbers). The backend routes to
# whichever candidate has headroom before each call, falling back through
# the rest on a live error. Default is tiered by quota and accuracy: two
# big-quota Flash-Lite models carry real traffic (each its own pool, so two
# roughly doubles daily capacity), four regular Flash variants absorb
# overflow at smaller quota but better accuracy, one more Flash-Lite is the
# last resort. Buying paid-tier credits later is just editing this list.
# GEMINI_MODELS=gemini-flash-lite-latest:12:480,gemini-3.1-flash-lite:12:480,gemini-3.6-flash:4:18,gemini-3.5-flash:4:18,gemini-3-flash:4:18,gemini-2.5-flash:4:18,gemini-2.5-flash-lite:8:18

# Fallback RPM/RPD for any bare (no ":rpm:rpd") entry in GEMINI_MODELS above.
# GEMINI_MODEL_RPM=12
# GEMINI_MODEL_RPD=480

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,https://your-username.github.io

# How many days of daily_logs/water_logs to keep before they're purged
# (rolling window, not calendar weeks). weight_logs is never purged — see
# sql/schema.sql. Keep this in sync with the interval in cleanup_old_logs().
# RETENTION_DAYS=7

# Optional: free Sentry project DSN (sentry.io) for backend error tracking.
# Leave blank to disable entirely — nothing else changes.
# SENTRY_DSN=

# Note: Turnstile (CAPTCHA on signup) has no backend env var — it's
# configured entirely in the Supabase dashboard (Authentication → Attack
# Protection), with its own secret key that never touches this backend. See
# frontend/js/config.js for the public site key the frontend needs.
