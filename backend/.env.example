# Supabase — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-public-key

# Google AI Studio — https://aistudio.google.com/app/apikey
# Task A (vision/food-photo scanning) primary — single key, no multi-key pool.
GEMINI_API_KEY=your-gemini-api-key

# --- The FREE text tier: Ollie chat, meal suggestions, weekly recap --------
# An operational rule: these three features cost $0.00. They never touch the
# paid Gemini key. Everything below is free-tier, no card, no billing.
#
# Ordered "provider:model" candidates, tried left to right; a provider with a
# blank key is skipped. That ordering IS the routing policy — there is no
# per-task table and no reasoning-effort vocabulary (see config.py's
# free_text_models comment for the full measurements, and for why
# openai/gpt-oss-* is deliberately NOT in this list).
#
# Groq first for latency (chat answers in 0.3-0.7s), Mistral second for
# headroom: Groq's free tier enforces 1,000 OUTPUT tokens per minute across
# the whole account, so a few requests drain it, and the 2,600-token meal-
# suggestion payload exceeds it outright. Mistral's free tier reports 625,000
# tokens/minute, so it serves the big payloads and the bursts at 5-25s.
# Both keys blank leaves chat/suggestions unavailable rather than billed —
# see FREE_TEXT_ALLOW_PAID_FALLBACK below.
#
# Get a Groq key free (no card) at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# FREE_TEXT_MODELS=groq:qwen/qwen3.8-27b,mistral:open-mistral-nemo

# Optional third candidate if Groq's per-minute output ceiling bites in
# production: Cerebras' free tier is published at 1M tokens/day with no
# comparable per-minute cliff. Its base URL is already registered in
# gemini_service.py, so enabling it is this key plus putting
# "cerebras:<model>" at the FRONT of FREE_TEXT_MODELS — no code change.
# Unlike the two above it has not been probed against these prompts; verify
# it honours response_format={"type":"json_object"} before trusting it.
# CEREBRAS_API_KEY=

# The escape hatch for the $0.00 rule, OFF by default. Left false, a chat or
# suggestion request that every free provider failed returns the same "the AI
# could not answer" error those endpoints already handle. Set true to accept a
# small spend (~$2-5/month at 20-50 users) in exchange for the feature never
# being unavailable.
# FREE_TEXT_ALLOW_PAID_FALLBACK=false

# --- The single non-Google fallback for the PAID pipeline -------------------
# Phase 2 collapsed a four-provider, task-routed chain down to one primary
# (Gemini) plus exactly one non-Google attempt per modality, tried only after
# Gemini has actually failed — which on a paid tier means a Google-side
# outage, not an exhausted quota. This covers the scan/describe/macro path,
# i.e. the calls whose numbers the product is actually made of.
#
# OPTIONAL. Blank simply means a Gemini failure surfaces to the caller, which
# every caller already handles.
#
# ONE key now covers BOTH modalities, which is why NVIDIA_API_KEY is gone.
# Probed live 2026-09-11, same prompts and images, six attempts each:
#   meta/llama-3.2-11b-vision via NVIDIA NIM  PARSE-FAILED 5 of 6 — it writes
#       correct markdown prose instead of JSON, and NIM has no response_format
#       to hold it to the schema. The rest of NIM's vision catalog on a free
#       key 404s, times out past 45s, or returns "503 ResourceExhausted".
#   mistral pixtral-12b-2409                  6 of 6 clean JSON, 2.2-3.8s.
# A leftover NVIDIA_API_KEY in your .env is harmless (config.py ignores
# unknown env vars, deliberately) but it does nothing.
#
# mistral-medium-3.5 and mistral-small-2603 remain unusable on the free tier:
# both still answer 429 with x-ratelimit-limit-req-minute=0, re-verified
# 2026-09-11.
MISTRAL_API_KEY=your-mistral-api-key
# MISTRAL_TEXT_FALLBACK_MODEL=open-mistral-nemo
# MISTRAL_VISION_FALLBACK_MODEL=pixtral-12b-2409

# --- Gemini model routing ---------------------------------------------------
# Primary for vision, text extraction and macro lookup — the paid pipeline.
# gemini-3.8-flash is both cheaper and better than the gemini-3.6-flash it
# replaced ($0.75/$3.75 per 1M vs $1.50/$7.50).
#
# THE RPM/RPD FIGURES ARE PLACEHOLDERS FOR A PAID TIER 1 PROJECT. Google does
# not publish per-model paid limits; yours are shown at
# https://aistudio.google.com/rate-limit. They only drive proactive quota
# gating and the frontend usage bar — too high just means relying on Google's
# own 429 (which the fallback handles), too low means refusing scans you could
# have run.
# GEMINI_MODEL_RPD IS THE GLOBAL SPEND CEILING — the only account-wide limit
# in the app, and the deployment's kill switch. The per-user caps in
# services/ai_usage_service.py bound what ONE person can spend; this bounds
# what everyone together can. gemini_service._generate_content refuses every
# call once it is hit.
#
# At measured per-call cost (~$0.004 average on gemini-3.8-flash):
#     2000/day ~= $8/day  ~= $240/month   <- the default
#     1000/day ~= $4/day  ~= $120/month
#      500/day ~= $2/day  ~=  $60/month
# LOWER IT if you want a tighter guarantee — the cost of too low is a friendly
# "AI is at capacity" message, which beats a surprise bill. It is in-memory and
# resets on restart, so set a Google Cloud billing budget as the real backstop.
# GEMINI_MODELS=gemini-3.8-flash:1000:2000
# GEMINI_MODEL_RPM=1000
# GEMINI_MODEL_RPD=2000

# Only reachable when FREE_TEXT_ALLOW_PAID_FALLBACK=true. Chat, meal
# suggestions and the recap run on the FREE tier above; this is what they fall
# back TO if you switch that on. $0.30/$2.50 per 1M against the primary's
# $0.75/$3.75, with its own quota pool so a chatty afternoon cannot eat the
# scan budget. While that flag stays false nothing here is ever billed.
# GEMINI_CHAT_MODELS=gemini-3.5-flash-lite:1000:10000
# GEMINI_CHAT_MODEL_RPM=1000
# GEMINI_CHAT_MODEL_RPD=10000

# The composite-dish "chef" — ENABLED as of Phase 2. A stew/"mix"/salata de
# boeuf has no single reference database entry, so it skips the nutrition DB
# and is priced by AI reasoning over the whole dish. Blank disables it and
# composites fall back to the ordinary text path.
# GEMINI_COMPOSITE_MODELS=gemini-3.8-flash:1000:300
# GEMINI_COMPOSITE_MODEL_RPM=1000
# GEMINI_COMPOSITE_MODEL_RPD=300

# --- Thinking levels --------------------------------------------------------
# Gemini 3.8 REPLACED the numeric thinking_budget with a string enum:
# "low" | "medium" | "high". "minimal" is rejected with a 400, and passing a
# numeric budget to 3.8 is an error — which is why the old *_THINKING_BUDGET
# variables are gone. A leftover one in your .env is ignored.
#
# Thinking tokens bill as OUTPUT, so these are a direct cost lever.
# GEMINI_VISION_THINKING_LEVEL=medium
# GEMINI_DESCRIPTION_THINKING_LEVEL=medium
# GEMINI_COMPOSITE_THINKING_LEVEL=high
# GEMINI_CHAT_THINKING_LEVEL=low
# GEMINI_LOOKUP_THINKING_LEVEL=low

# ============================================================================
# Web Push notifications — standards-based VAPID push, no Firebase/OneSignal.
# Optional: both blank means push is simply off (routers/notifications.py's
# endpoints 503 cleanly instead of crashing). Requires an always-on process
# to actually deliver in the background (see CLAUDE.md's Web Push section) —
# viable now that this runs on a 24/7 VPS rather than a scale-to-zero host.
# ============================================================================

# Generate a keypair once with (see backend/config.py's own comment for the
# exact command — py_vapid ships no ready-made "print me a keypair" helper):
#   python3 -c "
#   from cryptography.hazmat.primitives import serialization
#   from py_vapid import Vapid02
#   from py_vapid.utils import b64urlencode
#   v = Vapid02(); v.generate_keys()
#   priv = v.private_key.private_numbers().private_value.to_bytes(32, 'big')
#   pub = v.public_key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
#   print('VAPID_PUBLIC_KEY=' + b64urlencode(pub))
#   print('VAPID_PRIVATE_KEY=' + b64urlencode(priv))
#   "
# The public key also needs to be copied into frontend/js/config.js's
# VAPID_PUBLIC_KEY — it's not secret (shipped to every browser), only the
# private key needs protecting.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# The `sub` claim every push service requires in the VAPID JWT (RFC 8292) —
# a contact URI so a push service operator can reach you if this server ever
# misbehaves. Must be "mailto:" + a real address you read, not a placeholder.
# VAPID_ADMIN_EMAIL=mailto:you@example.com

# Comma-separated list of origins allowed to call this API
# FastAPI's /docs, /redoc and /openapi.json — served PUBLICLY and
# unauthenticated by default. Measured on this app: /openapi.json returned
# 118KB enumerating all 55 routes and every payload schema to anyone who
# asked. Leave unset in production. Set true only for local development.
# API_DOCS_ENABLED=false

ALLOWED_ORIGINS=http://localhost:5173,https://your-username.github.io

# How many days of daily_logs/water_logs to keep before they're purged
# (rolling window, not calendar weeks). weight_logs is never purged — see
# sql/schema.sql. Keep this in sync with the interval in cleanup_old_logs().
# RETENTION_DAYS=7

# Optional: free Sentry project DSN (sentry.io) for backend error tracking.
# Leave blank to disable entirely — nothing else changes.
# SENTRY_DSN=

# Nutrition database grounding (services/nutrition_db_service.py) — before
# trusting the AI's own recalled macros for an identified food, this looks
# it up against USDA FoodData Central and Open Food Facts, using the
# database's real values on a confident text match instead. Open Food Facts
# needs no key and works with everything below left blank; USDA needs its
# own free key for full coverage of generic/raw ingredients — get one
# instantly (no approval wait) at https://api.data.gov/signup. DEMO_KEY
# works for local testing but is rate-limited hard (30/hour) — never use it
# in production, a real key is free and instant.
# USDA_API_KEY=your-usda-api-key
# Kill switch — set to false to instantly revert to pure-AI estimation
# (skips both database sources entirely) without a code rollback.
# NUTRITION_DB_GROUNDING_ENABLED=true
#
# --- Phase 1: local nutrition corpus -----------------------------------------
# Retrieve candidates from the local public.nutrition_corpus table (one
# indexed hybrid vector + full-text query) instead of two HTTP calls per name
# to the rate-limited USDA / Open Food Facts APIs.
#
# Turn this on ONLY after BOTH:
#   1. running sql/phase1_nutrition_corpus.sql in the Supabase SQL editor, and
#   2. running  python3 scripts/ingest_nutrition_corpus.py --usda --off
# and confirming the corpus is populated AND embedded:
#   select count(*) from public.nutrition_corpus where embedding is not null;
# Left false, the backend keeps using the remote APIs exactly as before, so
# this is safe to deploy ahead of the migration.
# NUTRITION_DB_LOCAL_CORPUS=false
#
# When the local corpus grounds nothing for a name, still try the remote APIs
# before giving up and letting the AI guess. Keep this TRUE: measured on the
# 46-case retrieval eval, local-only grounds 83% while local + remote grounds
# 100% (the corpus has all of USDA but only the Romania slice of Open Food
# Facts, so it misses globally-catalogued items like walnuts or rice flour).
# NUTRITION_DB_REMOTE_FALLBACK=true
#
# How many fused candidates the hybrid RPC returns before the plausibility
# gates filter them. Raising it costs local CPU, not network calls — but
# re-run tests/test_retrieval_eval.py if you change it.
# NUTRITION_DB_MATCH_COUNT=40
#
# Where the ~220MB embedding model is cached. Must be writable and should
# persist across restarts, or every boot re-downloads it.
# FASTEMBED_CACHE_DIR=/tmp/ironlog-fastembed

# Note: Turnstile (CAPTCHA on signup) has no backend env var — it's
# configured entirely in the Supabase dashboard (Authentication → Attack
# Protection), with its own secret key that never touches this backend. See
# frontend/js/config.js for the public site key the frontend needs.
