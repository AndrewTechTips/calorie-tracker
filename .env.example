# Iron Log — production stack env file (docker-compose.yml).
#
# cp .env.example .env, then fill in real values. This single file is read
# TWICE by the stack: docker-compose.yml itself interpolates ${API_DOMAIN}/
# ${ACME_EMAIL} into Traefik's config, and `env_file: .env` on the backend
# service passes every var below straight through to the FastAPI process
# (backend/config.py::Settings reads them the same way it reads a local
# backend/.env in dev — see backend/.env.example for that workflow, which
# this file's backend section mirrors).
#
# Never commit the real .env — it's already in .gitignore.

# ============================================================================
# Reverse proxy (Traefik) — bare-metal deploy only, no backend/config.py
# equivalent
# ============================================================================

# The domain this API will be served from, e.g. api.yourdomain.com. Must
# already have an A/AAAA record pointing at this server's public IP before
# `docker compose up` — Traefik's ACME HTTP challenge needs that to issue a
# Let's Encrypt certificate.
API_DOMAIN=api.example.com

# Let's Encrypt sends renewal/expiry notices here. Any address works; use one
# you actually read.
ACME_EMAIL=you@example.com

# ============================================================================
# Backend — Supabase (Project Settings → API)
# ============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-public-key

# ============================================================================
# Backend — AI providers (see CLAUDE.md's "Task-based AI routing" section
# for the full fallback-chain explanation; only the required keys are
# uncommented below, every model-tuning var has a working default in
# backend/config.py if left unset)
# ============================================================================

# Task A (vision/food-photo scanning) primary — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Task B/C (text/JSON + conversational AI) primary — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your-mistral-api-key

# Task B/C first fallback — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Optional — Task A fallback only reached if Gemini's whole model chain
# fails. Leave blank to disable. https://build.nvidia.com
# NVIDIA_API_KEY=

# Optional — backend error tracking (sentry.io). Leave blank to disable.
# SENTRY_DSN=

# ============================================================================
# Backend — misc
# ============================================================================

# Your frontend's real origin(s), comma-separated (GitHub Pages URL, plus
# http://localhost:5173 if you also want local frontend dev to hit this
# deployed backend). CORS rejects every other origin.
ALLOWED_ORIGINS=https://your-username.github.io

# Rolling window (days) for daily_logs/water_logs retention. Keep in sync
# with sql/schema.sql's cleanup_old_logs() interval if you change it.
# RETENTION_DAYS=7
